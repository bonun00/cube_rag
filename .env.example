# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
#   macOS / Linux : cp .env.example .env
# .env 는 커밋하지 않는다. 이 파일에는 실제 키를 넣지 않는다.

# SSAFY GMS (OpenAI 호환 API)
GMS_KEY=
GMS_BASE_URL=
CHAT_MODEL=
EMBED_MODEL=

# Speedsolving Wiki 호출 시 User-Agent — 프로젝트명과 연락처 (HTTP 헤더라 영문만)
WIKI_USER_AGENT=CubeRAG/0.1 (SSAFY AI project; contact: your-email@example.com)
